{
  "name": "backend",
  "scripts": {
    "dev": "bun run --inspect=localhost:6499/debug --hot src/index.ts",
    "debug": "bun run src/index.ts",
    "build": "bun build --compile --minify --sourcemap --target=bun-linux-x64 ./src/index.ts --outfile ./build/backend",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run ./src/db/seed.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^2.27.0",
    "@hono/clerk-auth": "^3.0.3",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@repo/engine": "workspace:*",
    "@repo/orpc": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/utils": "workspace:*",
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.0",
    "postgres": "^3.4.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  }
}
